# Point the UI at the read-only API (waystone3 api-serve, default port 9200).
# Use IPv4 loopback so Next's /api rewrite does not depend on localhost → ::1.
# The browser still talks only to the UI origin; Next forwards /api to FastAPI.
# For IBKR KPIs without GCS, set IBKR_STAGED=1 on the API (see docs/IBKR_DAILY.md).
NEXT_PUBLIC_API_BASE=http://127.0.0.1:9200
