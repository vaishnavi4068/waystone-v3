# Copy to .env (gitignored) and fill in values. Do not commit .env.
#
# Massive / Polygon REST (Stocks news + indices/futures/options data)
MASSIVE_API_KEY=
POLYGON_API_KEY=
POLYGON_BASE_URL=https://api.massive.com
#
# GCS research publish (optional on Mac; often injected by Cloud Agent shell)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# IBKR_REPORTS_BUCKET=waystone-data
#
# Grok Bot ops (optional)
# GROK_BOT_WEBHOOK_URL=
# GROK_BOT_WEBHOOK_KEY=
# GROK_BOT_INBOX_TOKEN=
